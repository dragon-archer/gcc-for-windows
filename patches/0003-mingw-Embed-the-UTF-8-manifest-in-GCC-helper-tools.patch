From 73f72fa1010b932825bf06b985d854a394b3b4bc Mon Sep 17 00:00:00 2001
From: Zhongteng Gui <dragon-archer@outlook.com>
Date: Mon, 23 Nov 2026 03:26:22 +0800
Subject: [PATCH] mingw: Embed the UTF-8 manifest in GCC helper tools

Besides compilers, also embed the existing manifest in the binutils
wrappers, collect2, the LTO helpers and the gcov tools so they can use
UTF-8 as their active code page and opt in to long-path support on
Windows.

gcc/ChangeLog:

	* config/i386/x-mingw32-utf8 (MINGW_MANIFEST_EXES): New variable.
	Use it to link the manifest resource into gcc-ar, gcc-nm,
	gcc-ranlib, collect2, lto-wrapper, lto-dump, gcov, gcov-dump
	and gcov-tool as well as the compiler executables.

Signed-off-by: Zhongteng Gui <dragon-archer@outlook.com>
---
 gcc/config/i386/x-mingw32-utf8 | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/gcc/config/i386/x-mingw32-utf8 b/gcc/config/i386/x-mingw32-utf8
index f67f06c6397..b5fe002ad82 100644
--- a/gcc/config/i386/x-mingw32-utf8
+++ b/gcc/config/i386/x-mingw32-utf8
@@ -28,9 +28,14 @@ utf8rc-mingw32.o : $(srcdir)/config/i386/utf8-mingw32.rc \
   $(srcdir)/config/i386/winnt-utf8.manifest
 	$(WINDRES) $< $@
 
-# Force compilers to link against the utf8 resource by directly adding
-# the object file to LIBS, which is used by all drivers.
+# Force compilers and some other executables to link against the utf8
+# resource by directly adding the object file to LIBS, which is used by
+# all executables.
 # Cannot add it to some .a because it have no symbols, thus will not be
 # extracted.
-$(COMPILERS): utf8rc-mingw32.o
-LIBS += $(if $(filter $(COMPILERS),$@),utf8rc-mingw32.o)
+MINGW_MANIFEST_EXES = $(COMPILERS) $(addsuffix $(exeext), \
+  gcc-ar gcc-nm gcc-ranlib collect2 lto-wrapper lto-dump \
+  gcov gcov-dump gcov-tool)
+
+$(MINGW_MANIFEST_EXES): utf8rc-mingw32.o
+LIBS += $(if $(filter $(MINGW_MANIFEST_EXES),$@),utf8rc-mingw32.o)
-- 
2.56.1.windows.1

