From f39c7b556e7cf66c9aa39b884030e832f1aec8be Mon Sep 17 00:00:00 2001
From: Iain Sandoe <iain@sandoe.co.uk>
Date: Sun, 4 Oct 2026 17:16:36 +0200
Subject: [PATCH] c++, middle-end: Do not leave a call to a unified cdtor body
 (C4) undefined

At -Os, -fdeclone-ctor-dtor is enabled, which splits a cdtor into a unified body (C4)
plus C1/C2 thunks.

A TU that inlines a thunk therefore materialises a call to a C4 whose own
offline body is DECL_EXTERNAL and so emitted by nobody, and the link fails with
an undefined reference.

This fires on targets without support for COMDAT or where ONE_ONLY decls are not
marked as DECL_WEAK.  The solution is to decline the inline of such thunks if they
would leave a reference to an un-emitted C4.

	PR libstdc++/125359

gcc/ChangeLog:

	* cgraph.h:
	* ipa-inline.cc (can_inline_edge_p):
	* lto-cgraph.cc (lto_output_node):
	(lto_output_varpool_node):
	(input_overwrite_node):
	(input_varpool_node):

gcc/cp/ChangeLog:

	* optimize.cc (maybe_thunk_body):

gcc/testsuite/ChangeLog:

	* g++.dg/opt/declone6-aux.cc: New test.
	* g++.dg/opt/declone6.C: New test.
	* g++.dg/opt/declone6.h: New test.
	* g++.dg/opt/declone-cdtor-lto.h: New test.

Signed-off-by: Iain Sandoe <iain@sandoe.co.uk>
---
 gcc/cgraph.h                                 |  6 +-
 gcc/cp/optimize.cc                           | 12 ++++
 gcc/ipa-inline.cc                            | 14 ++++
 gcc/lto-cgraph.cc                            |  4 ++
 gcc/testsuite/g++.dg/opt/declone-cdtor-lto.C | 69 ++++++++++++++++++++
 gcc/testsuite/g++.dg/opt/declone6-aux.cc     |  8 +++
 gcc/testsuite/g++.dg/opt/declone6.C          | 61 +++++++++++++++++
 gcc/testsuite/g++.dg/opt/declone6.h          | 26 ++++++++
 8 files changed, 199 insertions(+), 1 deletion(-)
 create mode 100644 gcc/testsuite/g++.dg/opt/declone-cdtor-lto.C
 create mode 100644 gcc/testsuite/g++.dg/opt/declone6-aux.cc
 create mode 100644 gcc/testsuite/g++.dg/opt/declone6.C
 create mode 100644 gcc/testsuite/g++.dg/opt/declone6.h

diff --git a/gcc/cgraph.h b/gcc/cgraph.h
index d9f3d4815b0..a1dc5f3b99d 100644
--- a/gcc/cgraph.h
+++ b/gcc/cgraph.h
@@ -149,7 +149,8 @@ public:
       must_remain_in_tu_name (false), must_remain_in_tu_body (false),
       unique_name (false), implicit_section (false), body_removed (false),
       semantic_interposition (flag_semantic_interposition),
-      used_from_other_partition (false), in_other_partition (false),
+      used_from_other_partition (false), no_external_definition (false),
+      in_other_partition (false),
       address_taken (false), in_init_priority_hash (false),
       need_lto_streaming (false), offloadable (false), ifunc_resolver (false),
       next_sharing_asm_name (NULL),
@@ -622,6 +623,9 @@ public:
 
   /* Set when variable is used from other LTRANS partition.  */
   unsigned used_from_other_partition : 1;
+  /* Set when no definition of this symbol is guaranteed to exist in any
+     translation unit.  */
+  unsigned no_external_definition : 1;
   /* Set when function is available in the other LTRANS partition.
      During WPA output it is used to mark nodes that are present in
      multiple partitions.  */
diff --git a/gcc/cp/optimize.cc b/gcc/cp/optimize.cc
index 0afeefd5704..83a3d7ba804 100644
--- a/gcc/cp/optimize.cc
+++ b/gcc/cp/optimize.cc
@@ -295,6 +295,8 @@ maybe_thunk_body (tree fn, bool force)
   DECL_ABSTRACT_P (fn) = false;
   if (!DECL_WEAK (fn))
     {
+      if (DECL_ONE_ONLY (fn))
+	symtab_node::get_create (fn)->no_external_definition = true;
       TREE_PUBLIC (fn) = false;
       DECL_EXTERNAL (fn) = false;
       DECL_INTERFACE_KNOWN (fn) = true;
@@ -327,6 +329,16 @@ maybe_thunk_body (tree fn, bool force)
       DECL_WEAK (fn) = false;
       DECL_COMDAT (fn) = false;
     }
+  else
+    {
+      /* Neither case above could claim the unified body for this TU, so keep
+	 vague linkage and may end up DECL_EXTERNAL.  However, no other TU
+	 will necessarily emit it.  */
+      symtab_node::get_create (fn)->no_external_definition = true;
+      /* It is an implementation detail of this TU.  */
+      DECL_VISIBILITY (fn) = VISIBILITY_HIDDEN;
+      DECL_VISIBILITY_SPECIFIED (fn) = 1;
+    }
 
   /* Find the vtt_parm, if present.  */
   for (vtt_parmno = -1, parmno = 0, fn_parm = DECL_ARGUMENTS (fn);
diff --git a/gcc/ipa-inline.cc b/gcc/ipa-inline.cc
index ba8bf11b66e..012c5f4301a 100644
--- a/gcc/ipa-inline.cc
+++ b/gcc/ipa-inline.cc
@@ -463,6 +463,20 @@ can_inline_edge_p (struct cgraph_edge *e, bool report,
       e->inline_failed = CIF_MUST_REMAIN_IN_TU;
       inlinable = false;
     }
+  /* Do not inline a body that still calls a target with no guaranteed
+     definition: the call would be duplicated into the caller, while the
+     callee's own body is DECL_EXTERNAL and so emitted by nobody.
+     However, allow always-inline.  */
+  if (inlinable && !DECL_DISREGARD_INLINE_LIMITS (callee->decl))
+    for (cgraph_edge *e2 = callee->callees; e2; e2 = e2->next_callee)
+      if (e2->callee->no_external_definition
+	  && DECL_EXTERNAL (e2->callee->decl))
+	{
+	  e->inline_failed = CIF_BODY_NOT_AVAILABLE;
+	  inlinable = false;
+	  break;
+	}
+
   if (!inlinable && report)
     report_inline_failed_reason (e);
   return inlinable;
