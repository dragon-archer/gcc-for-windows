   bp_pack_value (&bp, node->implicit_section, 1);
   bp_pack_value (&bp, node->address_taken, 1);
@@ -635,6 +636,7 @@ lto_output_varpool_node (struct lto_simple_output_block *ob, varpool_node *node,
 		 node->body_removed
 		 || (!encode_initializer_p && !node->alias && node->definition),
 		 1);
+  bp_pack_value (&bp, node->no_external_definition, 1);
   bp_pack_value (&bp, node->semantic_interposition, 1);
   bp_pack_value (&bp, node->implicit_section, 1);
   bp_pack_value (&bp, node->writeonly, 1);
@@ -1268,6 +1270,7 @@ input_overwrite_node (struct lto_file_decl_data *file_data,
   node->must_remain_in_tu_body = bp_unpack_value (bp, 1);
   node->unique_name = bp_unpack_value (bp, 1);
   node->body_removed = bp_unpack_value (bp, 1);
+  node->no_external_definition = bp_unpack_value (bp, 1);
   node->semantic_interposition = bp_unpack_value (bp, 1);
   node->implicit_section = bp_unpack_value (bp, 1);
   node->address_taken = bp_unpack_value (bp, 1);
@@ -1477,6 +1480,7 @@ input_varpool_node (struct lto_file_decl_data *file_data,
   node->must_remain_in_tu_body = bp_unpack_value (&bp, 1);
   node->unique_name = bp_unpack_value (&bp, 1);
   node->body_removed = bp_unpack_value (&bp, 1);
+  node->no_external_definition = bp_unpack_value (&bp, 1);
   node->semantic_interposition = bp_unpack_value (&bp, 1);
   node->implicit_section = bp_unpack_value (&bp, 1);
   node->writeonly = bp_unpack_value (&bp, 1);
diff --git a/gcc/testsuite/g++.dg/opt/declone-cdtor-lto.C b/gcc/testsuite/g++.dg/opt/declone-cdtor-lto.C
new file mode 100644
index 00000000000..59ad5e698f6
--- /dev/null
+++ b/gcc/testsuite/g++.dg/opt/declone-cdtor-lto.C
@@ -0,0 +1,69 @@
+// PR c++/125359
+
+// Check that we do not leave a call to a unified cdtor in an LTO build.
+// { dg-do run { target c++14 } }
+// { dg-require-effective-target lto }
+// { dg-options "-Os -flto -fstrict-aliasing" }
+// { dg-skip-if "requires hosted libstdc++ for cassert" { ! hostedlib } }
+
+#include <cassert>
+#include <memory>
+#include <string>
+
+class Base
+{
+public:
+  Base* previous = nullptr;
+  Base* next = nullptr;
+  Base* target = nullptr;
+};
+
+class Target : public Base
+{
+public:
+  __attribute__((always_inline)) ~Target()
+  {
+    while (this->next)
+    {
+      Base* n = this->next;
+
+      if (n->previous)
+        n->previous->next = n->next;
+      if (n->next)
+        n->next->previous = n->previous;
+      n->previous = nullptr;
+      n->next = nullptr;
+      n->target = nullptr;
+    }
+  }
+};
+
+template <typename T>
+class TargetWithData final : public Target
+{
+public:
+  TargetWithData(T data)
+    : data(data)
+  {}
+  T data;
+};
+
+void test()
+{
+  Base ptr;
+  {
+    auto data = std::make_unique<TargetWithData<std::string>>(std::string("asdf"));
+    ptr.target = &*data;
+    ptr.previous = &*data;
+    data->next = &ptr;
+
+    assert(ptr.target != nullptr);
+  }
+  assert(ptr.target == nullptr);
+}
+
+int main(int, char**)
+{
+  test();
+  return 0;
+}
diff --git a/gcc/testsuite/g++.dg/opt/declone6-aux.cc b/gcc/testsuite/g++.dg/opt/declone6-aux.cc
new file mode 100644
index 00000000000..3cbe4de1234
--- /dev/null
+++ b/gcc/testsuite/g++.dg/opt/declone6-aux.cc
@@ -0,0 +1,8 @@
+// Emitter for declone6.C.  It includes the same header, so it sees
+// the `extern template' declaration, and then overrides it with an explicit
+// instantiation def -- which [temp.explicit] permits provided the
+// definition follows the declaration, as it does here.
+
+#include "declone6.h"
+
+template struct B<int>;			// the override: emit them HERE
diff --git a/gcc/testsuite/g++.dg/opt/declone6.C b/gcc/testsuite/g++.dg/opt/declone6.C
new file mode 100644
index 00000000000..613545943cb
--- /dev/null
+++ b/gcc/testsuite/g++.dg/opt/declone6.C
@@ -0,0 +1,61 @@
+// PR c++/111019
+
+// declone6.h holds inline definitions plus `extern template struct B<int>;', so the
+// bodies are VISIBLE in both TUs while neither is told to emit them.
+// declone6-aux.cc overrides that with an explicit instantiation DEFINITION, which
+// [temp.explicit] permits after the declaration, making it the one designated
+// emitter.  The program is therefore exactly what the standard asks for.
+//
+// At -Os the clones become forwarding thunks to a unified C4 body; if a thunk is
+// inlined here, the call to that C4 must not be left behind, because nothing in the
+// source can name a C4 and so no TU can be asked to export one.
+//
+// { dg-do run { target c++20 } }
+// { dg-options "-Os" }
+// { dg-additional-sources "declone6-aux.cc" }
+
+#include "declone6.h"
+
+struct D : B<int>			// derived: uses B<int>::C2 (base-object ctor)
+{
+  D (int x) : B<int> (x) {}
+};
+
+struct Sink
+{
+  __attribute__((always_inline)) ~Sink () { total += v; }
+  static int total;
+  int v;
+};
+int Sink::total;
+
+template <typename T>
+struct Holder : Sink
+{
+  T held;
+  Holder (const T &x) : held (x) { v = held.n; }
+};
+
+B<int> *p;
+D *q;
+
+__attribute__((noinline)) static int
+use (int x)
+{
+  p = new B<int> (x);			// uses B<int>::C1 (complete-object ctor)
+  q = new D (x);
+  {
+    B<int> t (x);
+    Holder<B<int> > h (t);		// needs B<int>'s copy cdtor HERE, by value
+    (void) h;
+  }
+  return p->n + q->n;
+}
+
+int
+main ()
+{
+  int a = use (2);
+  int b = use (2);
+  return !(a == b && Sink::total != 0);
+}
diff --git a/gcc/testsuite/g++.dg/opt/declone6.h b/gcc/testsuite/g++.dg/opt/declone6.h
new file mode 100644
index 00000000000..d2e210005af
--- /dev/null
+++ b/gcc/testsuite/g++.dg/opt/declone6.h
@@ -0,0 +1,26 @@
+// Shared "header" for declone6.C and declone6-aux.cc.  The definitions must be
+// inline to live here, which is the point: the explicit instantiation decl
+// below tells every includer not to emit them, and exactly one TU overrides it with
+// an explicit instantiation def to become the designated emitter,
+// declone6-aux.cc
+//
+// Shaped after std::basic_string, which triggered this case.
+
+template <typename T>
+struct B
+{
+  T n;
+
+  constexpr B (T x) : n (x)
+  {
+    for (int i = 0; i < 16; i++)
+      n += (x ^ i) + (n >> 1);
+  }
+
+  constexpr B (const B &o) : n (o.n) { n += 1; }
+
+  constexpr ~B () { n = 0; }
+};
+
+// The declaration: "do not instantiate the definitions here."
+extern template struct B<int>;
