From 6c0b04457d7ee7e5a4709323bcef779cf363732b Mon Sep 17 00:00:00 2001
From: Zhongteng Gui <dragon-archer@outlook.com>
Date: Tue, 20 Oct 2026 22:44:30 +0800
Subject: [PATCH] gnattools: Correct cygwin32 to cygwin

Fix typo.  Theres's no *-*-cygwin32 triplet.

gnattools/ChangeLog:

	* configure: Regenerate.
	* configure.ac: Correct cygwin32 to cygwin.

Signed-off-by: Zhongteng Gui <dragon-archer@outlook.com>
---
 gnattools/configure    | 2 +-
 gnattools/configure.ac | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/gnattools/configure b/gnattools/configure
index 2386a72d0fa..f42db03321b 100755
--- a/gnattools/configure
+++ b/gnattools/configure
@@ -3090,7 +3090,7 @@ case "${target}" in
   *-*-vxworks*)
     TOOLS_TARGET_PAIRS="indepsw.adb<indepsw-gnu.adb"
     ;;
-  *-*-cygwin32* | *-*-mingw32* | *-*-pe)
+  *-*-cygwin* | *-*-mingw32* | *-*-pe)
     TOOLS_TARGET_PAIRS="indepsw.adb<indepsw-gnu.adb"
     EXTRA_GNATTOOLS='../../gnatdll$(exeext)'
     ;;
diff --git a/gnattools/configure.ac b/gnattools/configure.ac
index 462afd655d4..6ea0bf256fd 100644
--- a/gnattools/configure.ac
+++ b/gnattools/configure.ac
@@ -76,7 +76,7 @@ case "${target}" in
   *-*-vxworks*)
     TOOLS_TARGET_PAIRS="indepsw.adb<indepsw-gnu.adb"
     ;;
-  *-*-cygwin32* | *-*-mingw32* | *-*-pe)
+  *-*-cygwin* | *-*-mingw32* | *-*-pe)
     TOOLS_TARGET_PAIRS="indepsw.adb<indepsw-gnu.adb"
     EXTRA_GNATTOOLS='../../gnatdll$(exeext)'
     ;;
-- 
2.56.0.windows.2

